<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="gripper_depth_camera">
    <static>true</static>
    <pose>0 0 3 0 1.5708 1.5708</pose>

    <link name="camera_link">
      <pose>0 0 0 0 0 0</pose>

      <visual name="camera_visual">
        <geometry>
          <box>
            <size>0.08 0.04 0.04</size>
          </box>
        </geometry>
      </visual>

      <sensor name="depth_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/gripper_camera/image</topic>

        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>5.0</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
