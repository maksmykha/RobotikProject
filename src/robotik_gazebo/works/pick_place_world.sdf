     <!-- green bin -->
    <model name="green_bin">
      <static>true</static>
      <!-- Set the position of the bin as a whole -->
      <pose>-0.75 0.20 0.765 0 0 0</pose> <!-- x, y, z of table top + bin bottom/2 -->

      <link name="link">
        <!-- Bottom -->
        <collision name="bottom_collision">
          <pose>0 0 0 0 0 0</pose> <!-- relative to link -->
          <geometry>
            <box><size>0.30 0.30 0.03</size></box>
          </geometry>
        </collision>
        <visual name="bottom_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box><size>0.30 0.30 0.03</size></box>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
          </material>
        </visual>

        <!-- Front wall -->
        <collision name="front_wall_collision">
          <pose>0 0.145 0.05 0 0 0</pose> <!-- offset from link origin -->
          <geometry>
            <box><size>0.30 0.01 0.10</size></box>
          </geometry>
        </collision>
        <visual name="front_wall_visual">
          <pose>0 0.145 0.05 0 0 0</pose>
          <geometry>
            <box><size>0.30 0.01 0.10</size></box>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
