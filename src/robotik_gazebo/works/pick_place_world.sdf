            <box>
              <size>0.06 0.06 0.75</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- BOXES -->
    <model name="obj_red">
      <static>true</static>
      <pose>0.55 0.15 0.82 0 0 0</pose>

      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
