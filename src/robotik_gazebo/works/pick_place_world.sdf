<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="pick_place_world">
    <!-- Physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -1</direction>
    </light>

    <!-- Ground -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- TABLE -->
    <model name="simple_table">
      <static>true</static>

      <!-- Tischplatte -->
      <link name="table_top">
        <pose>0 0 0.75 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>2.0 1.0 0.05</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>2.0 1.0 0.05</size>
            </box>
          </geometry>

          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Tischbein 1 -->
      <link name="leg1">
        <pose>0.9 0.45 0.375 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.06 0.06 0.75</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.06 0.06 0.75</size>
            </box>
          </geometry>
        </visual>
      </link>

      <!-- Tischbein 2 -->
      <link name="leg2">
        <pose>-0.9 0.45 0.375 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.06 0.06 0.75</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.06 0.06 0.75</size>
            </box>
          </geometry>
        </visual>
      </link>

      <!-- Tischbein 3 -->
      <link name="leg3">
        <pose>0.9 -0.45 0.375 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.06 0.06 0.75</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.06 0.06 0.75</size>
            </box>
          </geometry>
        </visual>
      </link>

      <!-- Tischbein 4 -->
      <link name="leg4">
        <pose>-0.9 -0.45 0.375 0 0 0</pose>

